CREATE DATABASE IF NOT EXISTS placement_db
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE placement_db;

CREATE TABLE IF NOT EXISTS students (
    id                BIGINT AUTO_INCREMENT PRIMARY KEY,
    name              VARCHAR(100)  NOT NULL,
    register_number   VARCHAR(30)   NOT NULL,
    department        VARCHAR(60)   NOT NULL,
    email             VARCHAR(100)  NOT NULL,
    phone             VARCHAR(15),
    cgpa              DOUBLE        NOT NULL,
    placement_status  VARCHAR(20)   NOT NULL,
    company_name      VARCHAR(100),
    created_at        DATETIME,
    updated_at        DATETIME,

    CONSTRAINT uk_students_register_number UNIQUE (register_number),
    CONSTRAINT uk_students_email UNIQUE (email),
    CONSTRAINT chk_students_cgpa CHECK (cgpa >= 0 AND cgpa <= 10),
    CONSTRAINT chk_students_status CHECK (placement_status IN ('PLACED', 'NOT_PLACED'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

